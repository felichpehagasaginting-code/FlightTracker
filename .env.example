# ==========================================
# TicketAI Configuration File (.env)
# ==========================================

# 1. Parameter Pemantauan Tiket
FLIGHT_ORIGIN=KNO
FLIGHT_DESTINATION=CGK
FLIGHT_TARGET_DATES=2026-09-17,2026-09-18,2026-09-19,2026-09-20

# 2. Threshold Harga (IDR)
MIN_AFFORDABLE_PRICE=1300000
MAX_AFFORDABLE_PRICE=1599000

# 3. Kredensial Telegram Bot API
# Buat bot gratis via Telegram @BotFather untuk mendapatkan TELEGRAM_BOT_TOKEN
# Dapatkan CHAT_ID akun/channel Anda via @userinfobot di Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STICKER_ID=

# 4. Interval Penjadwalan Pemantauan (Menit)
CHECK_INTERVAL_MINUTES=30
